{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "Enrich": [ "FromLogContext", "WithProcessId", "WithEnvironmentName" ],
    "WriteTo": [
      { "Name": "Console", "Args": { "outputTemplate": "[{Timestamp:O}] [{Level:u3}] {SourceContext} {Message:lj}{NewLine}{Exception}" } }
    ]
  },
  "AllowedHosts": "*"
}